{
  "chapterId": "ch1",
  "version": 1,
  "schemaVersion": 1,
  "id": "ch1_mao_edge_dff",
  "title": "卯时·渡口击木｜边沿 D 触发器",
  "description": "渡口击木：先通过封存药方解锁【门控 D 锁存器】官方元件。用 2 枚该元件和 1 只非门组成主从上升沿 D 触发器：主锁存器 EN=¬CLK，副锁存器 EN=CLK，主级 Q 接副级 D。先在 CLK=0 时稳定输入 D，再使 CLK 从 0 上升到 1；只有上升沿采样。高电平期间即使 D 变化，Q 和 Qbar 也必须保持。参考计算元件数：3。",
  "layer": "sequential",
  "interface": {
    "inputs": [
      {
        "name": "D",
        "width": 1
      },
      {
        "name": "CLK",
        "width": 1
      }
    ],
    "outputs": [
      {
        "name": "Q",
        "width": 1
      },
      {
        "name": "Qbar",
        "width": 1
      }
    ]
  },
  "allowedTypes": [
    "input",
    "output",
    "not"
  ],
  "allowedPackages": [
    "mao_d_latch"
  ],
  "initialGraph": {
    "schemaVersion": 1,
