  "boards": {
    "mengjin-jade-sixbit": {
      "title": "九村五贡物 · 阴阳玉版",
      "sceneId": "mengjin-jade-courtyard",
      "skin": "jade-01",
      "questions": [
        {
          "id": "01-01",
          "text": "45种村庄—贡物组合，至少需要几位二进制编码？",
          "options": [
            "5位",
            "6位",
            "7位",
            "8位"
          ],
          "correct": 1,
          "explanation": "2⁵=32＜45≤64=2⁶"
        },
        {
          "id": "01-02",
          "text": "6位二进制编码最多能表示多少种组合？",
          "options": [
            "32种",
            "45种",
            "64种",
            "128种"
          ],
          "correct": 2,
          "explanation": "2⁶=64"
        }
      ]
    },
    "mengjin-diviner-four-symbols": {
      "title": "双玉璜 · 阴阳四象",
      "sceneId": "mengjin-diviner-residence",
      "skin": "shell-01",
      "questions": [
        {
          "id": "02-01",
          "text": "两片玉璜各有阴、阳两态，共有几种不同排列？",
          "options": [
            "2种",
            "3种",
            "4种",
            "8种"
          ],
          "correct": 2,
          "explanation": "2²=4"
        },
        {
          "id": "02-02",
          "text": "阴=0、阳=1，从左读，“阳阴”记作什么？",
          "options": [
            "00",
            "01",
            "10",
            "11"
          ],
          "correct": 2,
          "explanation": "阳阴对应10"
        }
      ]
    },
    "mengjin-school-truth-table": {
      "title": "授业上 · 三位输入真值表",
      "sceneId": "mengjin-school-courtyard",
      "skin": "jade-02",
      "questions": [
        {
          "id": "03-01",
          "text": "ABC=000，至少两位为1才输出Y=1。Y=？",
          "options": [
            "0",
            "1",
            "未定义",
            "2"
          ],
          "correct": 0,
          "explanation": "000中没有1"
        },
        {
          "id": "03-02",
          "text": "ABC=011，至少两位为1才输出Y=1。Y=？",
          "options": [
            "0",
            "1",
            "未定义",
            "2"
          ],
          "correct": 1,
          "explanation": "011恰有两位为1"
        },
        {
          "id": "03-03",
          "text": "ABC至少两位为1时Y=1。按000、001、010、011、100、101、110、111的顺序，Y的序列是？",
          "options": [
            "00000111",
            "00010111",
            "00110111",
            "00011111"
          ],
          "correct": 1,
          "explanation": "依次为0、0、0、1、0、1、1、1"
        }
      ]
    },
    "mengjin-school-fault-check": {
