          "options": [
            "4",
            "5",
            "6",
            "0"
          ],
          "correct": 1,
          "explanation": "Y=X=5"
        },
        {
          "id": "07-02",
          "text": "算筹按Y=X+1运算。X=5时，Y=？",
          "options": [
            "4",
            "5",
            "6",
            "7"
          ],
          "correct": 2,
          "explanation": "Y=5+1=6"
        }
      ]
    },
