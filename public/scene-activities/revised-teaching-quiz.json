      "sceneId": "mengjin-school-courtyard",
      "skin": "jade-02",
      "questions": [
        {
          "id": "04-01",
          "text": "Y=A异或B。哪组“输入→实测输出”有误？",
          "options": [
            "00→0",
            "01→1",
            "10→0",
            "11→0"
          ],
          "correct": 2,
          "explanation": "10的正确输出应为1"
        }
      ]
    },
    "mengjin-school-delay-path": {
