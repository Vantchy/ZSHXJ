      "sceneId": "mengjin-school-courtyard",
      "skin": "jade-02",
      "questions": [
        {
          "id": "05-01",
          "text": "上路3级、下路7级，同时启动，每级延迟1息。总延迟为？",
          "options": [
            "3息",
            "7息",
            "10息",
            "8息"
          ],
          "correct": 1,
          "explanation": "两路并行，取max(3,7)=7"
        }
      ]
    },
    "mengjin-school-signal-regen": {
      "title": "授业下 · 衰减与信号再生",
      "sceneId": "mengjin-school-courtyard",
      "skin": "jade-02",
      "questions": [
        {
          "id": "06-01",
          "text": "强度8的信号传两级（每级减2），经再生器恢复到8，再传两级。末端强度为？",
          "options": [
            "2",
            "4",
            "6",
            "8"
          ],
          "correct": 1,
          "explanation": "再生后重新从8计，8−2×2=4"
        }
      ]
    },
