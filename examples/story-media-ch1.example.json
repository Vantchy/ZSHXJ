        },
        {
          "speaker": {
            "name": "旁白"
          },
          "text": "火光映照城墙。"
        }
      ]
    },
    {
      "id": "background-change",
      "lines": [
        {
          "speaker": {
            "characterId": "artisan-yan"
          },
          "text": "夜色降临，工坊又换了模样。",
          "media": {
            "path": "/assets/story/ch1/images/forge-dusk.webp",
            "type": "image",
            "display": "background"
          }
        }
      ]
    },
    {
      "id": "bronze-detail",
      "lines": [
        {
          "speaker": {
            "name": "旁白"
          },
          "text": "你注意到桌面上刻有花纹的铜片。",
          "media": {
            "path": "/assets/story/ch1/images/bronze-detail.webp",
            "type": "image",
            "display": "embed"
          }
        }
      ]
    },
    {
      "id": "choice-at-forge",
      "lines": [
        {
          "speaker": {
            "characterId": "artisan-yan"
          },
          "text": "今日你想先做什么？"
